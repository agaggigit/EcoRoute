<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versi Windows wajib ditulis: WebView2CompositionControl butuh Microsoft.Windows.SDK.NET -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- API key TomTom ditanam ke exe saat build, tidak pernah ditulis di source code.
       Sumber: -p:TomTomApiKey=... atau environment variable TOMTOM_API_KEY. -->
  <PropertyGroup>
    <TomTomApiKey Condition="'$(TomTomApiKey)' == ''">$(TOMTOM_API_KEY)</TomTomApiKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(TomTomApiKey)' != ''">
    <AssemblyMetadata Include="TomTomApiKey" Value="$(TomTomApiKey)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Maps\map.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Trayek & halte Trans Jogja dari OpenStreetMap (dibuat tools/ambil_trayek_transjogja.py) -->
    <Content Include="Data\trayek-transjogja.json" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>

<ItemGroup>
    <Page Include="LoginWindow.xaml"
          Condition="'$(EnableDefaultPageItems)' == 'false'" />
</ItemGroup>
</Project>
