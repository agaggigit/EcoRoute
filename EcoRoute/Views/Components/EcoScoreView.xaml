<!--
    Panel Eco Score (tampil di posisi card kiri, menggantikan card Jelajah selama dibuka). Pemilik: Annora (ringkasan riwayat) + Eco Score.
    Binding: EcoScore (EcoScoreRingkasan dari EcoScoreCalculator), StatusRiwayat
-->
<UserControl x:Class="EcoRoute.Views.Components.EcoScoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="400">

    <!-- Kartu di posisi card kiri (lebar mengikuti wadah di MainWindow), gaya sama dengan card lain -->
    <Border Style="{StaticResource FloatingCardStyle}"
            Padding="20">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Eco Score" Style="{StaticResource TitleText}"/>
                <TextBlock Text="CO₂ yang kamu hemat dibanding naik mobil"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,20"/>

                <!-- Level + poin + progres -->
                <Border Background="{StaticResource EcoGreenSoftBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding EcoScore.IkonLevel}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="36"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Level" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding EcoScore.NamaLevel}"
                                           Foreground="{StaticResource EcoGreenBrush}"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Poin"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding EcoScore.Poin}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>

                        <ProgressBar Minimum="0"
                                     Maximum="1"
                                     Value="{Binding EcoScore.ProgresKeLevelBerikut, Mode=OneWay}"
                                     Height="8"
                                     Margin="0,14,0,6"
                                     Foreground="{StaticResource EcoGreenBrush}"
                                     Background="{StaticResource CardBackgroundBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding EcoScore.KeteranganLevel}"
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Border>

                <!-- CO2 dihemat + setara pohon -->
                <Border BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CO₂ dihemat" Style="{StaticResource CaptionText}"/>
                        <TextBlock Foreground="{StaticResource EcoGreenBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Text="{Binding EcoScore.EmisiDihematKg, StringFormat={}{0:0.00} kg}"/>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0">
                            <Run Text="&#x1F333; Setara"/>
                            <Run Text="{Binding EcoScore.SetaraPohon, StringFormat={}{0:0.0}, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text="pohon menyerap CO₂ selama setahun"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Ringkasan riwayat (panel awal Annora) -->
                <Border BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Total emisi CO₂" Style="{StaticResource CaptionText}"/>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding EcoScore.TotalEmisiKg, StringFormat={}{0:0.00} kg CO₂}"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Perjalanan" Style="{StaticResource CaptionText}"/>
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding EcoScore.TotalPerjalanan}"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Total jarak" Style="{StaticResource CaptionText}"/>
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding EcoScore.TotalJarakKm, StringFormat={}{0:0.0} km}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Perjalanan tanpa emisi langsung" Style="{StaticResource CaptionText}"/>
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource EcoGreenBrush}"
                                   Text="{Binding EcoScore.PerjalananTanpaEmisi}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="CO₂ dihemat = emisi mobil − emisi moda yang dipilih, dihitung dalam kondisi lalu lintas lancar. 1 kg dihemat = 10 poin."
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <TextBlock Text="Satu pohon menyerap ±21 kg CO₂ per tahun (European Environment Agency)."
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding StatusRiwayat}"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
