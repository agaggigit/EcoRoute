<!--
    Daftar saran lokasi di bawah kolom input. Ditempel ke TextBox lewat SaranLokasiBehavior (di dalam Popup).
    Binding (DataContext = SaranLokasiViewModel): Daftar (Place: Nama, Alamat), PilihCommand
-->
<UserControl x:Class="EcoRoute.Views.Components.DaftarSaranView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SaranItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Margin memberi ruang untuk bayangan card di dalam Popup transparan -->
    <Border Style="{StaticResource FloatingCardStyle}" Padding="6" Margin="8,4,8,12">
        <ListBox x:Name="Daftar"
                 ItemsSource="{Binding Daftar}"
                 ItemContainerStyle="{StaticResource SaranItemStyle}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MaxHeight="320">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Ikon pin peta (MapPin2) dari Segoe Fluent / MDL2; Segoe UI Symbol punya glyph lain di kode ini -->
                        <TextBlock Text="&#xE7B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Top" Margin="0,3,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Nama}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Alamat}" Style="{StaticResource CaptionText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       ToolTip="{Binding Alamat}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
