<!--
    State C, L, E - Input rute + loading + error. Pemilik: Akio (tampilan diperbarui bersama tema baru).
    Binding: DaftarModa (Nama, Ikon), SelectedModa, TitikAsal, TitikTujuan, KolomAktif (IsAsalAktif / IsTujuanAktif),
             PetunjukKlikPeta, ErrorMessage, CurrentState,
             TukarCommand, HitungEmisiCommand (C -> L -> D/E), PratinjauAsalCommand, PratinjauTujuanCommand, TutupCommand (-> A)
    Hasil (State D) ada di EmissionResultView, ditempel di bagian bawah card ini.
-->
<UserControl x:Class="EcoRoute.Views.Components.RouteInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:EcoRoute.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">

    <UserControl.Resources>
        <!-- Chip moda: bulat, hijau lembut saat dipilih. Lebar mengikuti sel UniformGrid supaya jaraknya sama. -->
        <Style x:Key="ModaChipStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Width="44" Height="40"
                                HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kolom titik awal / tujuan: garis hijau saat aktif (klik peta mengisi kolom ini) -->
        <Style x:Key="KolomAsalStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAsalAktif}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KolomTujuanStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTujuanAktif}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource FloatingCardStyle}">
        <!-- Bisa digulir kalau card lebih tinggi dari jendela, tanpa scrollbar yang terlihat -->
        <ScrollViewer Style="{StaticResource HiddenScrollViewer}">
        <StackPanel>
            <!-- Pilihan moda + tombol tutup: 6 sel sama lebar, jadi jarak antar ikon (termasuk X) sama -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.ColumnSpan="5"
                         ItemsSource="{Binding DaftarModa}"
                         SelectedValuePath="Nama"
                         SelectedValue="{Binding SelectedModa}"
                         ItemContainerStyle="{StaticResource ModaChipStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="{Binding Ikon}"
                                       ToolTip="{Binding Nama}"
                                       FontSize="18"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        FontSize="13" Width="40" Height="40"
                        ToolTip="Tutup" AutomationProperties.Name="Tutup rute" Command="{Binding TutupCommand}"/>
            </Grid>

            <!-- Titik awal & tujuan + penanda rute + tombol tukar -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Warna penanda sama dengan di peta: titik biru = asal, hijau = tujuan -->
                <Ellipse Width="11" Height="11" Stroke="#3B82F6" StrokeThickness="3"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Line Grid.RowSpan="3" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill"
                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" StrokeDashArray="1,2"
                      HorizontalAlignment="Left" Margin="4.5,28,0,28"/>
                <Ellipse Grid.Row="2" Width="11" Height="11" Fill="{StaticResource PrimaryBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBox x:Name="KolomAsal" Grid.Column="1" Style="{StaticResource KolomAsalStyle}"
                         Tag="Titik awal: ketik atau klik peta"
                         AutomationProperties.Name="Titik awal"
                         components:SaranLokasiBehavior.Sumber="{Binding SaranAsal}"
                         GotKeyboardFocus="KolomAsal_GotKeyboardFocus"
                         Text="{Binding TitikAsal, UpdateSourceTrigger=PropertyChanged}">
                    <!-- Enter: cari titik awal dan tandai di peta -->
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PratinjauAsalCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox x:Name="KolomTujuan" Grid.Row="2" Grid.Column="1" Style="{StaticResource KolomTujuanStyle}"
                         Tag="Tujuan: ketik atau klik peta"
                         AutomationProperties.Name="Tujuan"
                         components:SaranLokasiBehavior.Sumber="{Binding SaranTujuan}"
                         GotKeyboardFocus="KolomTujuan_GotKeyboardFocus"
                         Text="{Binding TitikTujuan, UpdateSourceTrigger=PropertyChanged}">
                    <!-- Enter: cari tujuan dan tandai di peta sebelum Hitung Emisi -->
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PratinjauTujuanCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource IconButtonStyle}" Content="&#xE8CB;"
                        ToolTip="Tukar titik awal dan tujuan" Command="{Binding TukarCommand}"
                        VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>

            <!-- Petunjuk klik peta (State C): kolom mana yang akan diisi -->
            <StackPanel Orientation="Horizontal" Margin="24,10,0,0"
                        Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateC_InputRoute'}">
                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding PetunjukKlikPeta}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Tombol hitung (C, E). Saat hasil tampil, mengganti lokasi / moda langsung menghitung ulang. -->
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Content="Hitung Emisi"
                    FontSize="14"
                    Padding="14,12"
                    Margin="0,16,0,0"
                    Command="{Binding HitungEmisiCommand}"
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateC_InputRoute,StateE_Error'}"/>

            <!-- State L: loading -->
            <StackPanel Margin="0,18,0,2"
                        Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateL_Loading'}">
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource PrimaryBrush}"
                             Background="{StaticResource PrimarySoftBrush}" BorderThickness="0"/>
                <TextBlock Text="Menghitung rute dan emisi..." Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- State E: error -->
            <Border Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,12,0,0"
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateE_Error'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE783;"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gagal menghitung rute" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- State D: hasil -->
            <components:EmissionResultView
                Margin="0,16,0,0"
                Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateD_RouteResult'}"/>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
