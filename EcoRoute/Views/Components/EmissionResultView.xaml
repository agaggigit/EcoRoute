<!--
    State D - Hasil rute: waktu, jarak, emisi, perbandingan moda, dan saran. Pemilik: Akio (tampilan diperbarui bersama tema baru).
    Binding: WaktuTampil, KondisiWaktu, KeteranganKemacetan, JarakKm, EmisiKarbonKg,
             AdaKeteranganBus, KeteranganBusSingkat, KeteranganBus,
             PerbandinganModa (Nama, Ikon, EmisiKg, WaktuTeks, RasioBar, IsTerpilih, IsRekomendasi), PilihModaCommand,
             InsightText, InsightDetail, IsModaRekomendasi
-->
<UserControl x:Class="EcoRoute.Views.Components.EmissionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="368">

    <UserControl.Resources>
        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Warna waktu tempuh mengikuti kemacetan (sama dengan warna garis rute di peta) -->
        <Style x:Key="WarnaKondisiStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KondisiWaktu}" Value="Lancar">
                    <Setter Property="Foreground" Value="{StaticResource TrafficLancarBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KondisiWaktu}" Value="Sedang">
                    <Setter Property="Foreground" Value="{StaticResource TrafficSedangBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KondisiWaktu}" Value="Padat">
                    <Setter Property="Foreground" Value="{StaticResource TrafficPadatBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KondisiWaktu}" Value="Macet">
                    <Setter Property="Foreground" Value="{StaticResource TrafficMacetBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Baris perbandingan moda: bisa diklik untuk memilih moda -->
        <Style x:Key="BarisModaStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,7">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,16"/>

        <!-- Tiga angka utama, ukurannya sama besar supaya tidak perlu dicari -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Waktu -->
            <Border Style="{StaticResource StatTileStyle}" ToolTip="{Binding KeteranganKemacetan}">
                <StackPanel>
                    <TextBlock Text="Waktu" Style="{StaticResource OverlineText}"/>
                    <TextBlock Text="{Binding WaktuTampil}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"
                               Style="{StaticResource WarnaKondisiStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KondisiWaktu}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Style="{StaticResource WarnaKondisiStyle}"/>
                        <TextBlock Text="{Binding KondisiWaktu}" FontSize="11" FontWeight="SemiBold"
                                   Style="{StaticResource WarnaKondisiStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Jarak -->
            <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                <StackPanel>
                    <TextBlock Text="Jarak" Style="{StaticResource OverlineText}"/>
                    <TextBlock Text="{Binding JarakKm, StringFormat={}{0:0.0} km}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Emisi -->
            <Border Grid.Column="4" Style="{StaticResource StatTileStyle}"
                    Background="{StaticResource EcoGreenSoftBrush}" BorderBrush="{StaticResource PrimaryBorderSoftBrush}">
                <StackPanel>
                    <TextBlock Text="Emisi" Style="{StaticResource OverlineText}" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0">
                        <Run Text="{Binding EmisiKarbonKg, StringFormat={}{0:0.00}, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                        <Run Text="kg" FontSize="12" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="CO₂" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Trayek bus (hanya saat moda Bus): singkat, rincian di tooltip -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="10" Background="#EFF6FF"
                ToolTip="{Binding KeteranganBus}"
                Visibility="{Binding AdaKeteranganBus, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE806;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#2563EB"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding KeteranganBusSingkat}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Perbandingan antar moda -->
        <TextBlock Text="Bandingkan moda" Style="{StaticResource SectionText}" Margin="0,18,0,6"/>
        <ItemsControl ItemsSource="{Binding PerbandinganModa}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="Row" Style="{StaticResource BarisModaStyle}" Margin="0,1"
                            AutomationProperties.Name="{Binding Nama}"
                            Command="{Binding DataContext.PilihModaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Nama}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Ikon" FontFamily="{StaticResource IconFont}" Text="{Binding Ikon}"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Nama" Text="{Binding Nama}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="Badge" Background="{StaticResource PrimarySoftBrush}" CornerRadius="6"
                                        Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Rekomendasi" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Bar emisi: panjang isi = RasioBar lewat ScaleX -->
                            <Grid Grid.Column="2" Height="6" VerticalAlignment="Center" Margin="10,0,10,0">
                                <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="3"/>
                                <Border x:Name="Bar" Background="{StaticResource TextMutedBrush}" CornerRadius="3"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding RasioBar}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Column="3" Text="{Binding WaktuTeks}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Emisi" Grid.Column="4" Text="{Binding EmisiKg, StringFormat={}{0:0.00} kg}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRekomendasi}" Value="True">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource EcoGreenBrush}"/>
                        </DataTrigger>
                        <!-- Moda yang dipilih: latar hijau lembut + teks tebal -->
                        <DataTrigger Binding="{Binding IsTerpilih}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ikon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Nama" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Emisi" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Badge" Property="Background" Value="White"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Saran singkat; penjelasan lengkap di tooltip ikon info -->
        <Grid Margin="8,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource LogoMark}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding InsightText}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" Background="Transparent" Cursor="Help"
                    ToolTip="{Binding InsightDetail}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="20000"
                    Margin="6,0,0,0">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Catat perjalanan: hanya rute yang dipakai yang masuk Riwayat dan Eco Score -->
        <Button FontSize="14"
                Padding="14,12"
                Margin="0,16,0,0"
                AutomationProperties.Name="Pakai rute ini"
                Command="{Binding CatatPerjalananCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPerjalananTercatat}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Pakai rute ini" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}"
                Visibility="{Binding IsPerjalananTercatat, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Tercatat di riwayat" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Perjalanan yang dipakai masuk Riwayat dan menambah Eco Score."
                   Style="{StaticResource CaptionText}" FontSize="11" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
