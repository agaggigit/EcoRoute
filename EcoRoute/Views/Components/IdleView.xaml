<!--
    State A - Search bar + card sambutan. Pemilik: Annora (tampilan diperbarui bersama tema baru).
    Binding: SearchQuery, CariCommand (A -> B), MulaiRuteCommand (A -> C), SaranCari,
             EcoScore (NamaLevel, IkonLevel, Poin, ProgresKeLevelBerikut, KeteranganLevel), ToggleEcoScoreCommand,
             PerjalananTerakhir + UlangiPerjalananCommand (-> L -> D), AdaPerjalananTerakhir,
             TempatSorotan + PilihTempatCommand (A -> B)
-->
<UserControl x:Class="EcoRoute.Views.Components.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:EcoRoute.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="400">

    <UserControl.Resources>
        <!-- Chip tempat populer -->
        <Style x:Key="PlaceChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Baris yang bisa diklik (perjalanan terakhir, strip Eco Score) -->
        <Style x:Key="BarisKlikStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ===== SEARCH BAR ===== -->
        <Border Style="{StaticResource FloatingCardStyle}"
                Padding="18,8,10,8"
                CornerRadius="24"
                MinHeight="58">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT PENCARIAN LOKASI -->
                <TextBox Grid.Column="0"
                         Style="{StaticResource InputBoxStyle}"
                         Tag="Cari lokasi tujuan..."
                         AutomationProperties.Name="Cari lokasi"
                         components:SaranLokasiBehavior.Sumber="{Binding SaranCari}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">

                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding CariCommand}"/>
                    </TextBox.InputBindings>

                </TextBox>

                <!-- TOMBOL PENCARIAN DAN RUTE -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE721;"
                            ToolTip="Cari lokasi"
                            Command="{Binding CariCommand}"
                            Width="38"
                            Height="38"
                            Margin="0,0,4,0"/>

                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource BorderLightBrush}"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"/>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE8CB;"
                            Foreground="{StaticResource PrimaryBrush}"
                            ToolTip="Isi titik awal dan tujuan"
                            AutomationProperties.Name="Mulai rute"
                            Command="{Binding MulaiRuteCommand}"
                            Width="38"
                            Height="38"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CARD SAMBUTAN ===== -->
        <Border Style="{StaticResource FloatingCardStyle}"
                Margin="0,12,0,0"
                Padding="20,20,20,14"
                CornerRadius="20">

            <StackPanel>

                <TextBlock Text="Mau ke mana hari ini?"
                           Style="{StaticResource TitleText}"
                           FontSize="22"/>
                <TextBlock Text="Cari tujuan di atas, atau klik langsung di peta."
                           Style="{StaticResource CaptionText}"
                           FontSize="12.5"
                           Margin="0,4,0,0"/>

                <!-- Strip Eco Score: ringkas, klik untuk membuka panel Eco Score -->
                <Button Style="{StaticResource BarisKlikStyle}"
                        Background="{StaticResource EcoGreenSoftBrush}"
                        Padding="12,10"
                        Margin="0,16,0,0"
                        ToolTip="Lihat Eco Score"
                        AutomationProperties.Name="Lihat Eco Score"
                        Command="{Binding ToggleEcoScoreCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EcoScore.IkonLevel}"
                                   FontFamily="Segoe UI Emoji" Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding EcoScore.NamaLevel, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <Run Text="·" Foreground="{StaticResource TextMutedBrush}"/>
                                <Run Text="{Binding EcoScore.Poin, Mode=OneWay, StringFormat={}{0} poin}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <ProgressBar Style="{StaticResource RoundedProgressStyle}"
                                         Value="{Binding EcoScore.ProgresKeLevelBerikut, Mode=OneWay}"
                                         Height="6"
                                         Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding EcoScore.KeteranganLevel}" Style="{StaticResource CaptionText}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Button>

                <!-- Perjalanan terakhir: sekali klik langsung dihitung ulang dengan kondisi sekarang -->
                <StackPanel Visibility="{Binding AdaPerjalananTerakhir, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Perjalanan terakhir"
                               Style="{StaticResource SectionText}"
                               Margin="0,18,0,4"/>
                    <ItemsControl ItemsSource="{Binding PerjalananTerakhir}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BarisKlikStyle}"
                                        Margin="-10,0"
                                        ToolTip="Hitung ulang dengan kondisi lalu lintas sekarang"
                                        Command="{Binding DataContext.UlangiPerjalananCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource InputBackgroundBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding IkonModa}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding NamaAsal, Mode=OneWay}"/>
                                                <Run Text="→" Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding NamaTujuan, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionText}" FontSize="11.5" Margin="0,1,0,0">
                                                <Run Text="{Binding ModaDipilih, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding JarakKm, StringFormat={}{0:0.0} km, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Tempat populer -->
                <TextBlock Text="Populer di Yogyakarta"
                           Style="{StaticResource SectionText}"
                           Margin="0,18,0,8"/>

                <ItemsControl ItemsSource="{Binding TempatSorotan}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PlaceChipStyle}"
                                    ToolTip="{Binding Alamat}"
                                    AutomationProperties.Name="{Binding Nama}"
                                    Command="{Binding DataContext.PilihTempatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE707;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,1,6,0"/>
                                    <TextBlock Text="{Binding Nama}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
