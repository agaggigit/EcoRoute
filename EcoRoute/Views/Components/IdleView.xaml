<!--
    State A - Search bar + card sambutan. Pemilik: Annora.
    Binding: SearchQuery, CariCommand (A -> B), MulaiRuteCommand (A -> C),
             TempatSorotan + PilihTempatCommand (A -> B), DaftarModa
-->
<UserControl x:Class="EcoRoute.Views.Components.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:EcoRoute.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="400">

    <UserControl.Resources>
        <!-- Chip tempat populer -->
        <Style x:Key="PlaceChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource EcoGreenSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource EcoGreenBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource EcoGreenBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ===== SEARCH BAR ===== -->
        <Border Style="{StaticResource FloatingCardStyle}"
                Padding="18,8,10,8"
                CornerRadius="24"
                MinHeight="58">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT PENCARIAN LOKASI -->
                <TextBox Grid.Column="0"
                         Style="{StaticResource InputBoxStyle}"
                         Tag="Cari lokasi tujuan..."
                         components:SaranLokasiBehavior.Sumber="{Binding SaranCari}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">

                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding CariCommand}"/>
                    </TextBox.InputBindings>

                </TextBox>

                <!-- TOMBOL PENCARIAN DAN RUTE -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- TOMBOL SEARCH -->
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE721;"
                            ToolTip="Cari lokasi"
                            Command="{Binding CariCommand}"
                            Width="38"
                            Height="38"
                            Margin="0,0,4,0"
                            Cursor="Hand"/>

                    <!-- PEMISAH -->
                    <Border Width="1"
                            Height="24"
                            Background="#E2E8F0"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- TOMBOL RUTE -->
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE8CB;"
                            Foreground="{StaticResource PrimaryBrush}"
                            ToolTip="Mulai rute perjalanan"
                            Command="{Binding MulaiRuteCommand}"
                            Width="38"
                            Height="38"
                            Cursor="Hand"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CARD SAMBUTAN ===== -->
        <Border Style="{StaticResource FloatingCardStyle}"
                Margin="0,12,0,0"
                Padding="20,18"
                CornerRadius="20">

            <StackPanel>

                <!-- Sapaan -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40"
                            CornerRadius="12"
                            Background="{StaticResource EcoGreenSoftBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#x1F33F;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="20"
                                   Foreground="{StaticResource EcoGreenBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Mau ke mana hari ini?"
                                   Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Pilih tujuan, lalu bandingkan emisi CO₂ dari 6 moda transportasi."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Tempat populer -->
                <TextBlock Text="Populer di Yogyakarta"
                           Style="{StaticResource SectionText}"
                           Margin="0,18,0,8"/>

                <ItemsControl ItemsSource="{Binding TempatSorotan}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PlaceChipStyle}"
                                    ToolTip="{Binding Alamat}"
                                    Command="{Binding DataContext.PilihTempatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE707;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource EcoGreenBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,1,6,0"/>
                                    <TextBlock Text="{Binding Nama}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Moda yang dibandingkan -->
                <TextBlock Text="Moda yang dibandingkan"
                           Style="{StaticResource SectionText}"
                           Margin="0,12,0,8"/>

                <ItemsControl ItemsSource="{Binding DaftarModa}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="38" Height="38"
                                        CornerRadius="19"
                                        Background="{StaticResource PrimarySoftBrush}">
                                    <TextBlock Text="{Binding Ikon}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="16"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Nama}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tips -->
                <Border Background="{StaticResource EcoGreenSoftBrush}"
                        CornerRadius="12"
                        Padding="12,10"
                        Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource EcoGreenBrush}"
                                   Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="Untuk jarak yang sama, naik bus menghasilkan emisi ±2x lebih rendah dibanding mobil."
                                   FontSize="12"
                                   Foreground="{StaticResource EcoGreenBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
