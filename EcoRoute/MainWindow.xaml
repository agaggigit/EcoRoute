
<Window x:Class="EcoRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcoRoute"
        xmlns:vm="clr-namespace:EcoRoute.ViewModels"
        xmlns:components="clr-namespace:EcoRoute.Views.Components"
        mc:Ignorable="d"
        Title="EcoRoute - Route and Carbon Emission Tracker"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        FontFamily="Segoe UI"
        Language="id-ID"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Style tombol sidebar -->
        <Style x:Key="RailButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Margin"
                    Value="0,4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <StackPanel Background="Transparent">

                            <Border x:Name="Pill"
                                    Width="44"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}">

                                <TextBlock
                                    Text="{TemplateBinding Tag}"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="16"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                Margin="0,3,0,0"
                                TextElement.FontSize="11"/>

                        </StackPanel>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource SurfaceHoverBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource TextPrimaryBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Style kategori tempat -->
        <Style x:Key="CategoryChipStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="19"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource FloatingShadow}">

                            <ContentPresenter
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource SurfaceHoverBrush}"/>

                </Trigger>

                <DataTrigger
                    Binding="{Binding IsAktif}"
                    Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource EcoGreenSoftBrush}"/>

                    <Setter Property="BorderBrush"
                            Value="{StaticResource EcoGreenBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource EcoGreenBrush}"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <!-- LAYOUT UTAMA -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR KIRI -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,1,0"
                Panel.ZIndex="2">

            <DockPanel LastChildFill="True">

                <!-- Logout di bawah sidebar -->
                <Button x:Name="LogoutButton"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource RailButtonStyle}"
                        Tag="&#xE8AC;"
                        Content="Logout"
                        ToolTip="Keluar dari akun"
                        Margin="0,0,0,20"
                        Click="LogoutButton_Click"/>

                <!-- Menu atas tanpa tombol hamburger -->
                <StackPanel Margin="0,16,0,0">

                    <!-- Jelajah tidak me-reset rute -->
                    <Button
                        Tag="&#xE707;"
                        Content="Jelajah"
                        ToolTip="Jelajahi peta"
                        Command="{Binding BukaJelajahCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource RailButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJelajahAktif}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource EcoGreenSoftBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource EcoGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Riwayat -->
                    <Button
                        Tag="&#xE81C;"
                        Content="Riwayat"
                        ToolTip="Riwayat perjalanan"
                        Command="{Binding ToggleMenuCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource RailButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMenuOpen}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource EcoGreenSoftBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource EcoGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Eco Score -->
                    <Button
                        Tag="&#x1F33F;"
                        Content="Eco Score"
                        ToolTip="Eco score kamu"
                        Command="{Binding ToggleEcoScoreCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource RailButtonStyle}">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEcoScoreOpen}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource EcoGreenSoftBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource EcoGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- AREA PETA DAN KONTEN -->
        <Grid Grid.Column="1">

            <!-- Peta -->
            <components:MapView/>

            <!-- Kartu Jelajah: state tetap tersimpan -->
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="16"
                  Width="400"
                  Visibility="{Binding IsJelajahAktif, Converter={StaticResource BoolToVisibility}}">

                <components:IdleView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateA_Idle'}"/>

                <components:PlaceCardView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateB_SearchLocation'}"/>

                <components:RouteInputView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateC_InputRoute,StateL_Loading,StateD_RouteResult,StateE_Error'}"/>

            </Grid>

            <!-- KATEGORI TEMPAT -->
            <ItemsControl
                ItemsSource="{Binding DaftarKategori}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="428,26,16,0"
                ClipToBounds="False"
                Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateA_Idle,StateB_SearchLocation'}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button
                            Style="{StaticResource CategoryChipStyle}"
                            ToolTip="{Binding Nama, StringFormat='Tampilkan hanya {0}'}"
                            Command="{Binding DataContext.PilihKategoriCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Nama}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="{Binding Ikon}"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>

                                <TextBlock
                                    Text="{Binding Nama}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- PANEL RIWAYAT DAN ECO SCORE -->
            <!-- Posisi panel mengikuti perbaikan AGA -->
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Margin="16"
                  Width="400">

                <!-- Panel Riwayat -->
                <Border
                    Style="{StaticResource FloatingCardStyle}"
                    VerticalAlignment="Top"
                    Padding="20"
                    Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top">

                            <TextBlock
                                Text="Riwayat Perjalanan"
                                Style="{StaticResource TitleText}"/>

                            <TextBlock
                                Text="{Binding StatusRiwayat}"
                                Style="{StaticResource CaptionText}"
                                TextWrapping="Wrap"
                                Margin="0,8,0,12"/>

                        </StackPanel>

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto">

                            <ItemsControl
                                ItemsSource="{Binding RiwayatPerjalanan}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">

                                            <StackPanel>

                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis">

                                                    <Run Text="{Binding NamaAsal, Mode=OneWay}"/>
                                                    <Run Text="→"/>
                                                    <Run Text="{Binding NamaTujuan, Mode=OneWay}"/>

                                                </TextBlock>

                                                <TextBlock
                                                    Style="{StaticResource CaptionText}"
                                                    Margin="0,2,0,0">

                                                    <Run Text="{Binding ModaDipilih, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding JarakKm, StringFormat={}{0:0.0} km, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run
                                                        Text="{Binding TotalEmisiKg, StringFormat={}{0:0.00} kg CO₂, Mode=OneWay}"
                                                        Foreground="{StaticResource EcoGreenBrush}"/>

                                                </TextBlock>

                                                <TextBlock
                                                    Text="{Binding Tanggal, StringFormat={}{0:dd MMM yyyy, HH:mm}}"
                                                    Style="{StaticResource CaptionText}"
                                                    Foreground="{StaticResource TextMutedBrush}"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </DockPanel>

                </Border>

                <!-- Panel Eco Score -->
                <components:EcoScoreView
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEcoScoreOpen, Converter={StaticResource BoolToVisibility}}"/>

            </Grid>

            <!-- NOTIFIKASI -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="416,0,16,32"
                MaxWidth="480"
                Padding="16,10"
                CornerRadius="10"
                Background="{StaticResource DangerSoftBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1"
                Effect="{StaticResource FloatingShadow}"
                Visibility="{Binding AdaNotifikasi, Converter={StaticResource BoolToVisibility}}">

                <TextBlock
                    Text="{Binding Notifikasi}"
                    Foreground="{StaticResource DangerBrush}"
                    TextWrapping="Wrap"/>

            </Border>

        </Grid>

    </Grid>

</Window>
