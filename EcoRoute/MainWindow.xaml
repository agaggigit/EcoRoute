<Window x:Class="EcoRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcoRoute"
        xmlns:vm="clr-namespace:EcoRoute.ViewModels"
        xmlns:components="clr-namespace:EcoRoute.Views.Components"
        mc:Ignorable="d"
        Title="EcoRoute - Route and Carbon Emission Tracker"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        FontFamily="Segoe UI"
        Language="id-ID"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Item rail kiri: ikon + label kecil di bawahnya -->
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Pill"
                                    Width="44" Height="30"
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              Margin="0,3,0,0"
                                              TextElement.FontSize="11"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chip kategori di atas peta -->
        <Style x:Key="CategoryChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="19"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource FloatingShadow}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsAktif}" Value="True">
                    <Setter Property="Background" Value="{StaticResource EcoGreenSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource EcoGreenBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource EcoGreenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/> <!-- Rail menu kiri -->
            <ColumnDefinition Width="*"/>  <!-- Peta + card -->
        </Grid.ColumnDefinitions>

        <!-- ===== Rail menu kiri (selalu tampil) ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,1,0"
                Panel.ZIndex="2">
            <StackPanel Margin="0,16,0,0">
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE700;"
                        FontSize="18"
                        Margin="0,0,0,20"
                        ToolTip="Menu"
                        Command="{Binding ToggleMenuCommand}"/>

                <!-- Jelajah: kembali ke peta (State A) -->
                <Button Style="{StaticResource RailButtonStyle}"
                        Tag="&#xE707;"
                        Content="Jelajah"
                        Background="{StaticResource EcoGreenSoftBrush}"
                        Foreground="{StaticResource EcoGreenBrush}"
                        ToolTip="Jelajahi peta"
                        Command="{Binding TutupCommand}"/>

                <Button Style="{StaticResource RailButtonStyle}"
                        Tag="&#xE81C;"
                        Content="Riwayat"
                        ToolTip="Riwayat perjalanan"
                        Command="{Binding ToggleMenuCommand}"/>

                <Button Style="{StaticResource RailButtonStyle}"
                        Tag="&#x1F33F;"
                        Content="Eco Score"
                        ToolTip="Eco score kamu"
                        Command="{Binding ToggleEcoScoreCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <!-- ===== Lapisan 1: Peta (Annora) ===== -->
            <components:MapView/>

            <!-- ===== Lapisan 2: Card per state ===== -->
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="16"
                  Width="400">
                <components:IdleView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateA_Idle'}"/>
                <components:PlaceCardView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateB_SearchLocation'}"/>
                <components:RouteInputView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateC_InputRoute,StateL_Loading,StateD_RouteResult,StateE_Error'}"/>
            </Grid>

            <!-- ===== Lapisan 2b: Chip kategori (filter pin di peta) ===== -->
            <ItemsControl ItemsSource="{Binding DaftarKategori}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="428,26,16,0"
                          ClipToBounds="False"
                          Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateA_Idle,StateB_SearchLocation'}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CategoryChipStyle}"
                                ToolTip="{Binding Nama, StringFormat='Tampilkan hanya {0}'}"
                                Command="{Binding DataContext.PilihKategoriCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Nama}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Ikon}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Nama}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Lapisan 3: Drawer menu (dibuka dari rail) ===== -->
            <Border HorizontalAlignment="Left"
                    Width="280"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource FloatingShadow}"
                    Padding="20"
                    Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Riwayat Perjalanan" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="{Binding StatusRiwayat}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12"/>
                    </StackPanel>

                    <!-- Data dari PostgreSQL (view v_riwayat_perjalanan) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RiwayatPerjalanan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding NamaAsal, Mode=OneWay}"/>
                                                <Run Text="→"/>
                                                <Run Text="{Binding NamaTujuan, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                                <Run Text="{Binding ModaDipilih, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding JarakKm, StringFormat={}{0:0.0} km, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding TotalEmisiKg, StringFormat={}{0:0.00} kg CO₂, Mode=OneWay}"
                                                     Foreground="{StaticResource EcoGreenBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Tanggal, StringFormat={}{0:dd MMM yyyy, HH:mm}}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Panel Eco Score: ringkasan perjalanan tersimpan ===== -->
            <Border HorizontalAlignment="Left"
                    Width="320"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource FloatingShadow}"
                    Padding="20"
                    Visibility="{Binding IsEcoScoreOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Eco Score" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Ringkasan jejak karbon dari riwayat perjalananmu"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,20"/>

                        <Border Background="{StaticResource EcoGreenSoftBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Total emisi CO₂" Style="{StaticResource CaptionText}"/>
                                <TextBlock Foreground="{StaticResource EcoGreenBrush}"
                                           FontSize="28" FontWeight="Bold"
                                           Text="{Binding TotalEmisiRiwayatKg, StringFormat={}{0:0.00} kg CO₂}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Jumlah perjalanan" Style="{StaticResource CaptionText}"/>
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding TotalPerjalanan}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Total jarak tempuh" Style="{StaticResource CaptionText}"/>
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding TotalJarakKm, StringFormat={}{0:0.0} km}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Perjalanan tanpa emisi langsung" Style="{StaticResource CaptionText}"/>
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource EcoGreenBrush}"
                                           Text="{Binding PerjalananTanpaEmisi}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Angka dihitung dari perjalanan yang tersimpan. Ini bukan skor atau peringkat lingkungan terstandar."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding StatusRiwayat}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Lapisan 4: Notifikasi (misal lokasi tidak ditemukan) ===== -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="416,0,16,32"
                    MaxWidth="480"
                    Padding="16,10"
                    CornerRadius="10"
                    Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource FloatingShadow}"
                    Visibility="{Binding AdaNotifikasi, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Notifikasi}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
