<Window x:Class="EcoRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcoRoute"
        xmlns:vm="clr-namespace:EcoRoute.ViewModels"
        xmlns:components="clr-namespace:EcoRoute.Views.Components"
        mc:Ignorable="d"
        Title="EcoRoute - Route and Carbon Emission Tracker"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        FontFamily="Segoe UI"
        Language="id-ID"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/> <!-- Rail menu kiri -->
            <ColumnDefinition Width="*"/>  <!-- Peta + card -->
        </Grid.ColumnDefinitions>

        <!-- ===== Rail menu kiri (selalu tampil) ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,1,0"
                Panel.ZIndex="2">
            <Button Style="{StaticResource IconButtonStyle}"
                    Content="&#xE700;"
                    FontSize="18"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    ToolTip="Menu"
                    Command="{Binding ToggleMenuCommand}"/>
        </Border>

        <Grid Grid.Column="1">
            <!-- ===== Lapisan 1: Peta (Annora) ===== -->
            <components:MapView/>

            <!-- ===== Lapisan 2: Card per state ===== -->
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="16"
                  Width="400">
                <components:IdleView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateA_Idle'}"/>
                <components:PlaceCardView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateB_SearchLocation'}"/>
                <components:RouteInputView
                    Visibility="{Binding CurrentState, Converter={StaticResource StateToVisibility}, ConverterParameter='StateC_InputRoute,StateL_Loading,StateD_RouteResult,StateE_Error'}"/>
            </Grid>

            <!-- ===== Lapisan 3: Drawer menu (dibuka dari rail) ===== -->
            <Border HorizontalAlignment="Left"
                    Width="280"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource FloatingShadow}"
                    Padding="20"
                    Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="EcoRoute" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Riwayat perjalanan dan eco score akan tampil di sini."
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
